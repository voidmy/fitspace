page {
  background: #f3f5f2;
  color: #14231e;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea,
swiper,
swiper-item,
image {
  box-sizing: border-box;
}

button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding-top: 0;
  padding-bottom: 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: normal;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 176rpx;
}

.card {
  background: #ffffff;
  border: 1rpx solid rgba(20, 35, 30, 0.05);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 38rpx rgba(20, 35, 30, 0.05);
}

.section {
  margin-top: 28rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 4rpx 18rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.section-more {
  color: #7c8883;
  font-size: 24rpx;
}

.primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 78rpx;
  padding: 0 32rpx;
  background: #ff6b35;
  color: #ffffff;
  font-weight: 650;
}

.secondary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  padding: 0 30rpx;
  background: #e9f7ef;
  color: #176a46;
  font-weight: 650;
}

.ghost-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 70rpx;
  padding: 0 28rpx;
  border: 1rpx solid #d9dfdc;
  background: #ffffff;
  color: #35433e;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 38rpx;
  margin-right: 10rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #edf7f1;
  color: #287254;
  font-size: 21rpx;
}

.muted {
  color: #86918d;
}

.price {
  color: #ff6b35;
  font-weight: 750;
}

.empty {
  padding: 80rpx 32rpx;
  text-align: center;
  color: #8a9691;
}

.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}
