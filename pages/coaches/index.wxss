.coaches-page {
  padding-bottom: 46rpx;
}

.coaches-hero {
  display: flex;
  flex-direction: column;
  min-height: 245rpx;
  padding: 40rpx 32rpx;
  border-radius: 34rpx;
  background:
    radial-gradient(circle at 90% 10%, rgba(255, 124, 72, 0.24), transparent 30%),
    #0c1814;
  color: #ffffff;
}

.hero-label {
  color: #6d9b87;
  font-size: 16rpx;
  letter-spacing: 5rpx;
}

.hero-title {
  margin-top: 26rpx;
  font-size: 39rpx;
  font-weight: 800;
}

.hero-desc {
  margin-top: 14rpx;
  color: #91a29b;
  font-size: 21rpx;
}

.filters {
  margin: 24rpx 0;
  white-space: nowrap;
}

.filter {
  display: inline-flex;
  align-items: center;
  height: 62rpx;
  margin-right: 12rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #6f7c76;
  font-size: 21rpx;
}

.filter.active {
  background: #19382b;
  color: #ffffff;
  font-weight: 680;
}

.coach-item {
  margin-bottom: 20rpx;
  overflow: hidden;
}

.coach-visual {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 300rpx;
  color: rgba(255, 255, 255, 0.92);
}

.initials {
  font-size: 96rpx;
  font-weight: 880;
  letter-spacing: -8rpx;
}

.experience {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.26);
  color: #ffffff;
  font-size: 19rpx;
}

.coach-copy {
  padding: 26rpx 26rpx 20rpx;
}

.coach-name-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.coach-name,
.coach-title {
  display: block;
}

.coach-name {
  font-size: 34rpx;
  font-weight: 800;
}

.coach-title {
  margin-top: 5rpx;
  color: #818d87;
  font-size: 21rpx;
}

.coach-price {
  color: #ef6330;
  font-size: 30rpx;
  font-weight: 780;
}

.coach-price text {
  font-size: 18rpx;
  font-weight: 500;
}

.tags {
  margin-top: 20rpx;
}

.intro {
  margin-top: 16rpx;
  color: #68756f;
  font-size: 21rpx;
  line-height: 1.65;
}

.result {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f6f8f7;
  color: #6e7b75;
  font-size: 20rpx;
  line-height: 1.6;
}

.result text {
  margin-right: 12rpx;
  color: #23734f;
  font-weight: 720;
}

.coach-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  border-top: 1rpx solid #edf0ee;
  color: #8a9490;
  font-size: 20rpx;
}

.coach-actions button {
  height: 58rpx;
  padding: 0 22rpx;
  background: #ff6b35;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
}

.coach-actions button.followed {
  background: #edf1ef;
  color: #68756f;
}
