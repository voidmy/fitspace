.coach-detail {
  min-height: 100vh;
  padding-bottom: 150rpx;
}

.detail-hero {
  position: relative;
  display: flex;
  align-items: flex-end;
  min-height: 480rpx;
  padding: 44rpx 32rpx;
  overflow: hidden;
  color: #ffffff;
}

.hero-initials {
  position: absolute;
  top: 70rpx;
  right: 40rpx;
  color: rgba(255, 255, 255, 0.2);
  font-size: 180rpx;
  font-weight: 900;
  letter-spacing: -14rpx;
}

.hero-copy {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
}

.hero-name {
  font-size: 54rpx;
  font-weight: 850;
}

.hero-title {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.75);
  font-size: 23rpx;
}

.hero-tags {
  display: flex;
  margin-top: 20rpx;
}

.hero-tags text {
  margin-right: 10rpx;
  padding: 8rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  font-size: 19rpx;
}

.detail-content {
  margin-top: -26rpx;
  padding: 0 24rpx;
}

.summary {
  position: relative;
  z-index: 3;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  padding: 26rpx 8rpx;
}

.summary-stat {
  display: flex;
  align-items: center;
  flex-direction: column;
  border-right: 1rpx solid #edf0ee;
}

.summary-stat:last-child {
  border-right: 0;
}

.summary-stat text:first-child {
  font-size: 30rpx;
  font-weight: 780;
}

.summary-stat text:last-child {
  margin-top: 6rpx;
  color: #8a9490;
  font-size: 19rpx;
}

.detail-card {
  margin-top: 18rpx;
  padding: 28rpx;
}

.detail-title {
  font-size: 29rpx;
  font-weight: 760;
}

.detail-text,
.result-content {
  margin-top: 16rpx;
  color: #6f7c76;
  font-size: 22rpx;
  line-height: 1.75;
}

.result-card {
  display: flex;
  flex-direction: column;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #163c2b, #0b1713);
  color: #ffffff;
}

.result-label {
  color: #58b682;
  font-size: 15rpx;
  letter-spacing: 4rpx;
}

.result-title {
  margin-top: 14rpx;
  font-size: 31rpx;
  font-weight: 780;
}

.result-content {
  color: #9cacA5;
}

.result-visual {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 26rpx;
}

.result-visual view:not(.result-arrow) {
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  width: 180rpx;
  height: 120rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.13);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.06);
}

.result-visual text:first-child {
  font-size: 23rpx;
  font-weight: 700;
}

.result-visual text:last-child {
  margin-top: 6rpx;
  color: #6d8f7f;
  font-size: 15rpx;
  letter-spacing: 2rpx;
}

.result-arrow {
  margin: 0 18rpx;
  color: #5ddd96;
  font-size: 40rpx;
}

.achievement {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: 18rpx;
  background: #f7f9f8;
  font-size: 22rpx;
}

.achievement view {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #e0f4e9;
  color: #218257;
  font-size: 20rpx;
  font-weight: 800;
}

.recommend-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 26rpx;
  padding: 26rpx;
}

.recommend-desc {
  width: 400rpx;
  margin-top: 7rpx;
  color: #8b9591;
  font-size: 19rpx;
}

.recommend-card button {
  height: 62rpx;
  padding: 0 20rpx;
  background: #fff0eb;
  color: #e65d32;
  font-size: 20rpx;
}

.recommend-card button.active {
  background: #ff6b35;
  color: #ffffff;
}

.book-bar {
  position: fixed;
  z-index: 10;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  gap: 14rpx;
  padding: 18rpx 24rpx 24rpx;
  border-top: 1rpx solid #e5eae7;
  background: rgba(255, 255, 255, 0.98);
}

.follow-btn {
  width: 160rpx;
  height: 82rpx;
  border: 1rpx solid #d9dfdc;
  background: #ffffff;
  color: #46564f;
}

.follow-btn.active {
  background: #e9f4ee;
  color: #247450;
}

.book-btn {
  flex: 1;
  height: 82rpx;
  background: #ff6b35;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 700;
}
