.verify-hero {
  display: flex;
  align-items: center;
  flex-direction: column;
  padding: 40rpx 24rpx 46rpx;
}

.scan-mark {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 150rpx;
  overflow: hidden;
  border: 3rpx solid #1d664a;
  border-radius: 38rpx;
  background: #dff3e7;
  color: #1d664a;
  font-size: 54rpx;
  font-weight: 850;
}

.scan-line {
  position: absolute;
  right: 12rpx;
  left: 12rpx;
  height: 3rpx;
  background: #ff6b35;
  box-shadow: 0 0 16rpx rgba(255, 107, 53, 0.6);
}

.verify-title {
  margin-top: 30rpx;
  font-size: 39rpx;
  font-weight: 790;
}

.verify-desc {
  margin-top: 12rpx;
  color: #84908a;
  font-size: 21rpx;
}

.verify-form {
  padding: 30rpx;
}

.form-label {
  font-size: 24rpx;
  font-weight: 700;
}

.source-row {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.source-chip {
  flex: 1;
  padding: 18rpx 8rpx;
  border: 1rpx solid #dce2df;
  border-radius: 18rpx;
  text-align: center;
  color: #6e7b75;
  font-size: 21rpx;
}

.source-chip.active {
  border-color: #2b8c62;
  background: #e7f6ed;
  color: #23734f;
  font-weight: 700;
}

.code-label {
  margin-top: 32rpx;
}

.code-input {
  display: flex;
  align-items: center;
  height: 88rpx;
  margin-top: 16rpx;
  padding: 0 12rpx 0 22rpx;
  border: 1rpx solid #dce2df;
  border-radius: 20rpx;
  background: #fafbfa;
}

.code-input input {
  flex: 1;
  font-size: 27rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.placeholder {
  color: #a3aba7;
  font-size: 22rpx;
  font-weight: 400;
  letter-spacing: 0;
}

.scan-btn {
  padding: 17rpx 20rpx;
  border-radius: 14rpx;
  background: #e8f5ed;
  color: #287753;
  font-size: 20rpx;
  font-weight: 680;
}

.verify-btn {
  width: 100%;
  margin-top: 28rpx;
}

.result-card {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 28rpx;
}

.result-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 76rpx;
  height: 76rpx;
  margin-right: 22rpx;
  border-radius: 50%;
  font-size: 38rpx;
  font-weight: 850;
}

.success .result-icon {
  background: #dff4e8;
  color: #1f8658;
}

.failure .result-icon {
  background: #fff0e8;
  color: #ef6330;
}

.result-title {
  font-size: 29rpx;
  font-weight: 760;
}

.result-message,
.result-code {
  margin-top: 7rpx;
  color: #7c8983;
  font-size: 20rpx;
}

.help-card {
  margin-top: 18rpx;
  padding: 28rpx;
}

.help-title {
  font-size: 25rpx;
  font-weight: 720;
}

.help-desc {
  margin-top: 10rpx;
  color: #7c8882;
  font-size: 21rpx;
  line-height: 1.7;
}
